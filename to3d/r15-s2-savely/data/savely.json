 "deco": "\nvoid deco(vec3 rp, vec2 uv, float m, inout vec3 base, inout vec3 bshd) {\n  if (abs(m - 3.0) < 0.5) {\n    // trousers below the waist; the vest over the trunk, open in a V at the neck where the shirt and a small tie show\n    if (rp.y < 0.779 && abs(rp.x) < 0.26) { base = vec3(0.459, 0.373, 0.325); bshd = vec3(0.196, 0.161, 0.255); return; }\n    bool trunk = abs(rp.x) < 0.140 - 0.5 * max(0.0, rp.y - 1.161);\n    float v = (rp.y - 1.030) * 0.42;\n    bool open = rp.z > 0.014 && abs(rp.x) < v;\n    if (trunk && !open && (rp.y < 1.276 || rp.z < 0.014)) {\n      base = vec3(0.470, 0.478, 0.341); bshd = vec3(0.200, 0.224, 0.265);\n      float e = min(abs(abs(rp.x) - v), abs(rp.y - 0.779));\n      if (rp.z > 0.014 && abs(abs(rp.x) - v) < 0.004 && v > 0.0) { base *= 0.72; bshd *= 0.8; }\n    } else if (open && abs(rp.x) < 0.012 + 0.006 * sin((rp.y - 1.030) * 30.0) && rp.y < 1.276 - 0.03) { base = vec3(0.50, 0.22, 0.20); bshd = vec3(0.27, 0.12, 0.17); }\n  }\n  if (abs(m - 5.0) < 0.5 && rp.z > 0.0) {\n    float e = min(1.0 - abs(uv.x), min(uv.y, 1.0 - uv.y) * 3.0);\n    if (e > 0.045 && e < 0.06) { base *= 0.8; bshd *= 0.85; }\n    // the apron's pocket with two tools, a stitched edge\n    vec2 p = vec2(rp.x + 0.035, rp.y - 0.84);\n    if (abs(p.x) < 0.05 && abs(p.y) < 0.042) { base *= 0.82; bshd *= 0.85;\n      if ((abs(p.x + 0.022) < 0.0035 || abs(p.x + 0.004) < 0.0035) && p.y > -0.02) { base = vec3(0.60, 0.60, 0.63); bshd = vec3(0.3, 0.28, 0.4); } }\n  }\n}",
